# ====================================================================
# Vibely Server Environment Configuration Template
# ====================================================================

# Port for the Node.js / Express backend (Render sets this automatically)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Connection URL:
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production (Supabase PostgreSQL):
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_URL="postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres"

# JWT Secret Key for signing user authentication tokens
JWT_SECRET=your_jwt_secret_min_32_chars_random_string_here

# JWT Expiration Period (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated in production)
# Example for local: http://localhost:5173
# Example for production: https://vibely.vercel.app,http://localhost:5173
CORS_ORIGIN="http://localhost:5173"
